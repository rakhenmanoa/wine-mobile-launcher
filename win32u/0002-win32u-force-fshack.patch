+/* WINE_FULLSCREEN_FORCE_FSHACK=1 : use the fullscreen hack path (and so the FSR upscaler with
+ * WINE_FULLSCREEN_FSR=1) even when the game did not change the display mode, the swapchain being
+ * scaled to the window size by the compute shaders. */
+static BOOL force_fshack(void)
+{
+    static int force = -1;
+    if (force < 0)
+    {
+        const char *e = getenv( "WINE_FULLSCREEN_FORCE_FSHACK" );
+        force = e && strcmp( e, "0" );
+    }
+    return force;
+}
+
 static BOOL surface_get_fshack_dpi( struct surface *surface )
 {
     UINT dpi = NtUserGetDpiForWindow( surface->hwnd ), raw = NtUserGetWinMonitorDpi( surface->hwnd, MDT_RAW_DPI );
-    return fshack_enabled && dpi != raw ? raw : 0;
+    if (!fshack_enabled) return 0;
+    if (dpi != raw) return raw;
+    return force_fshack() ? (raw ? raw : 96) : 0;
 }
 
