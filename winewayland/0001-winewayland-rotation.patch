+/**********************************************************************
+ *          Rotation (WINE_WAYLAND_ROTATE)
+ *
+ * Wine voit un écran paysage (largeur/hauteur échangées par rapport au
+ * compositeur). Les tampons sont rendus en paysage et le compositeur les fait
+ * pivoter (buffer_transform 90 ou 270), si bien que la surface est en portrait.
+ *
+ *  90  : (bx,by) -> (by, Bw-bx)   inverse : bx = Bw-sy, by = sx
+ *  270 : (bx,by) -> (Bh-by, bx)   inverse : bx = sy,    by = Bh-sx
+ */
+int wayland_get_rotation(void)
+{
+    static int rotation = -1;
+    if (rotation < 0)
+    {
+        const char *env = getenv("WINE_WAYLAND_ROTATE");
+        rotation = env ? atoi(env) : 0;
+        if (rotation != 90 && rotation != 270) rotation = 0;
+        if (rotation) TRACE("rotation=%d\n", rotation);
+    }
+    return rotation;
+}
+
+uint32_t wayland_get_buffer_transform(void)
+{
+    switch (wayland_get_rotation())
+    {
+    case 90: return WL_OUTPUT_TRANSFORM_90;
+    case 270: return WL_OUTPUT_TRANSFORM_270;
+    default: return WL_OUTPUT_TRANSFORM_NORMAL;
+    }
+}
+
+void wayland_surface_size_from_window(struct wayland_surface *surface, int window_w, int window_h,
+                                      int *surface_w, int *surface_h)
+{
+    int w = round(window_w / surface->window.scale);
+    int h = round(window_h / surface->window.scale);
+    if (wayland_get_rotation()) { *surface_w = h; *surface_h = w; }
+    else { *surface_w = w; *surface_h = h; }
+}
+
+void wayland_surface_size_to_window(struct wayland_surface *surface, double surface_w, double surface_h,
+                                    int *window_w, int *window_h)
+{
+    if (wayland_get_rotation()) { double t = surface_w; surface_w = surface_h; surface_h = t; }
+    *window_w = round(surface_w * surface->window.scale);
+    *window_h = round(surface_h * surface->window.scale);
+}
+
+/* Point de la fenêtre parente (parent_w x parent_h, coordonnées fenêtre) -> surface */
+static void rotate_point_from_window(struct wayland_surface *surface, int parent_w,
+                                     double x, double y, int parent_h, double *sx, double *sy)
+{
+    double scale = surface->window.scale;
+    double bw = parent_w / scale, bh = parent_h / scale;
+    x /= scale; y /= scale;
+    switch (wayland_get_rotation())
+    {
+    case 90: *sx = y; *sy = bw - x; break;
+    case 270: *sx = bh - y; *sy = x; break;
+    default: *sx = x; *sy = y; break;
+    }
+}
+
+void wayland_surface_rect_from_window(struct wayland_surface *surface, int parent_w, int parent_h,
+                                      const RECT *window_rect, RECT *surface_rect)
+{
+    double x0, y0, x1, y1;
+    rotate_point_from_window(surface, parent_w, window_rect->left, window_rect->top, parent_h, &x0, &y0);
+    rotate_point_from_window(surface, parent_w, window_rect->right, window_rect->bottom, parent_h, &x1, &y1);
+    surface_rect->left = round(min(x0, x1));
+    surface_rect->top = round(min(y0, y1));
+    surface_rect->right = round(max(x0, x1));
+    surface_rect->bottom = round(max(y0, y1));
+}
+
+void wayland_surface_point_from_window(struct wayland_surface *surface, int window_x, int window_y,
+                                       int *surface_x, int *surface_y)
+{
+    double sx, sy;
+    rotate_point_from_window(surface, surface->window.rect.right - surface->window.rect.left,
+                             window_x, window_y,
+                             surface->window.rect.bottom - surface->window.rect.top, &sx, &sy);
+    *surface_x = round(sx);
+    *surface_y = round(sy);
+}
+
+void wayland_surface_point_to_window(struct wayland_surface *surface, double surface_x, double surface_y,
+                                     int *window_x, int *window_y)
+{
+    double scale = surface->window.scale;
+    double bw = (surface->window.rect.right - surface->window.rect.left) / scale;
+    double bh = (surface->window.rect.bottom - surface->window.rect.top) / scale;
+    double x, y;
+    switch (wayland_get_rotation())
+    {
+    case 90: x = bw - surface_y; y = surface_x; break;
+    case 270: x = surface_y; y = bh - surface_x; break;
+    default: x = surface_x; y = surface_y; break;
+    }
+    *window_x = round(x * scale);
+    *window_y = round(y * scale);
+}
+
+void wayland_surface_delta_to_window(struct wayland_surface *surface, double surface_dx, double surface_dy,
+                                     double *window_dx, double *window_dy)
+{
+    double x, y;
+    switch (wayland_get_rotation())
+    {
+    case 90: x = -surface_dy; y = surface_dx; break;
+    case 270: x = surface_dy; y = -surface_dx; break;
+    default: x = surface_dx; y = surface_dy; break;
+    }
+    *window_dx = x * surface->window.scale;
+    *window_dy = y * surface->window.scale;
+}
+
