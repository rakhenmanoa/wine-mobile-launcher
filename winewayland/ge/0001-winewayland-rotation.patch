+/**********************************************************************
+ *          Rotation (WINE_WAYLAND_ROTATE=90|270)
+ *
+ * Wine voit un écran paysage ; la surface Wayland reste portrait et les
+ * tampons sont rendus en paysage puis pivotés par le compositeur
+ * (wl_surface.set_buffer_transform).
+ *
+ *  90  : fenêtre (x,y) -> surface (y, W-x)    inverse : x = W-sy, y = sx
+ *  270 : fenêtre (x,y) -> surface (H-y, x)    inverse : x = sy,   y = H-sx
+ * (W,H = taille de la fenêtre en coordonnées fenêtre)
+ */
+int wayland_get_rotation(void)
+{
+    static int rotation = -1;
+    if (rotation < 0)
+    {
+        const char *env = getenv("WINE_WAYLAND_ROTATE");
+        rotation = env ? atoi(env) : 0;
+        if (rotation != 90 && rotation != 270) rotation = 0;
+        if (rotation) TRACE("rotation=%d\n", rotation);
+    }
+    return rotation;
+}
+
+uint32_t wayland_get_buffer_transform(void)
+{
+    switch (wayland_get_rotation())
+    {
+    case 90: return WL_OUTPUT_TRANSFORM_90;
+    case 270: return WL_OUTPUT_TRANSFORM_270;
+    default: return WL_OUTPUT_TRANSFORM_NORMAL;
+    }
+}
+
+/* Seuls les toplevels et leurs sous-surfaces sont pivotés (pas les popups,
+ * ni les surfaces layer comme l'overlay Steam). */
+static int surface_rotation(struct wayland_surface *surface)
+{
+    if (surface->role == WAYLAND_SURFACE_ROLE_POPUP ||
+        surface->role == WAYLAND_SURFACE_ROLE_LAYER) return 0;
+    return wayland_get_rotation();
+}
+
+void wayland_surface_set_rotation_transform(struct wayland_surface *surface)
+{
+    wl_surface_set_buffer_transform(surface->wl_surface,
+                                    surface_rotation(surface) ? wayland_get_buffer_transform()
+                                                              : WL_OUTPUT_TRANSFORM_NORMAL);
+}
+
+static void rotate_to_surface(int rotation, double fw, double fh, double x, double y,
+                              double *ox, double *oy)
+{
+    switch (rotation)
+    {
+    case 90: *ox = y; *oy = fw - x; break;
+    case 270: *ox = fh - y; *oy = x; break;
+    default: *ox = x; *oy = y; break;
+    }
+}
+
+static RECT rect_to_surface(struct wayland_surface *surface, double fw, double fh, RECT rect)
+{
+    int rotation = surface_rotation(surface);
+    double s = surface->window.scale, x0, y0, x1, y1;
+    RECT out;
+
+    rotate_to_surface(rotation, fw, fh, rect.left, rect.top, &x0, &y0);
+    rotate_to_surface(rotation, fw, fh, rect.right, rect.bottom, &x1, &y1);
+    out.left = round(min(x0, x1) / s);
+    out.top = round(min(y0, y1) / s);
+    out.right = round(max(x0, x1) / s);
+    out.bottom = round(max(y0, y1) / s);
+    return out;
+}
+
+static void surface_frame_size(struct wayland_surface *surface, double *fw, double *fh)
+{
+    *fw = surface->window.rect.right - surface->window.rect.left;
+    *fh = surface->window.rect.bottom - surface->window.rect.top;
+}
+
