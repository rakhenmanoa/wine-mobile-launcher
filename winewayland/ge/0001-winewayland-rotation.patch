+ * opposite sense, hence the swap. */
+static int surface_geom_rotation(struct wayland_surface *surface)
+{
+    switch (surface_rotation(surface))
+    {
+    case 90: return 270;
+    case 270: return 90;
+    default: return 0;
+    }
